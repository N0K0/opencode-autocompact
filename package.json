  "repository": {
    "type": "git",
    "url": "git+https://github.com/N0K0/opencode-autocompact.git"
  },
  "bugs": {
    "url": "https://github.com/N0K0/opencode-autocompact/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
